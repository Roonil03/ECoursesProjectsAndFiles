@using EventEase.Models

<div class="card my-3 shadow-sm">
    <div class="card-body">
        <h5 class="card-title">@EventItem.Name</h5>
        <p class="card-text"><strong>Date:</strong> @EventItem.Date.ToShortDateString()</p>
        <p class="card-text"><strong>Location:</strong> @EventItem.Location</p>
        
        <div class="mt-2">
            <label class="form-label font-weight-bold">Quick Edit Event Title:</label>
            <input class="form-control" @bind="EventItem.Name" @bind:event="oninput" />
        </div>
        
        <div class="mt-3">
            <a href="/event/@EventItem.Id" class="btn btn-primary btn-sm">View Details</a>
            <a href="/register/@EventItem.Id" class="btn btn-outline-secondary btn-sm ms-2">Register</a>
        </div>
    </div>
</div>

@code {
    [Parameter] 
    public Event EventItem { get; set; } = new();
}
